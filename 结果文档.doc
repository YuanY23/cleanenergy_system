<tr><td>P3</td><td>谷价0.7倍/峰价1.3倍</td><td>optimal</td><td>1.8571</td><td>40,554.39</td><td>78,672.63</td><td>0</td><td>57,680.07</td><td>3,599.24</td><td>21,052.63</td><td>19,000.00</td><td>25,480.00</td><td>28,000.00</td><td>116,400</td></tr>
